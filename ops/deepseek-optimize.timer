[Unit]
Description=每 15 分钟运行 DeepSeek 策略参数优化器

[Timer]
# 每天 96 次(每 15 分钟)。分钟位用 07/22/37/52 而不是 00/15/30/45 ——
# 整刻是全网定时任务最拥堵的时刻，错开能避开 API 侧的瞬时排队。
OnCalendar=*-*-* *:07,22,37,52:00
# 机器关机/重启错过了时点，开机后补跑一次
Persistent=true
# 0-120s 抖动，避免与其他任务同刻并发
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
