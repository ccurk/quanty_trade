def experiment_hold(cfg):
    """实验期内冻结 _exp.changed 里列出的键（返回键名集合）。

    为什么必须是代码级约束、而不能只写在提示词里：提示词约束不了输出。
    实测风险：本脚本每 3h 一轮，_exp 的 eval 窗口是 6h —— 若某一轮把实验
    正在改的键改回去，实验就被**静默撤销**了，6h 后拿到的数据是两种参数
    混在一起的，而且没有人会发现。所以把"实验期冻结"做成硬约束。

    eval_after 到点自动解冻（返回空集），无需人工清理 —— 无人值守时会忘。
    status 以 closed 开头也解冻，用于人工提前收工。
    """
    exp = (cfg or {}).get("_exp")
    if not isinstance(exp, dict):
        return set()
    if str(exp.get("status", "")).startswith("closed"):
        return set()
    until = exp.get("eval_after")
    if until:
        try:
            t = calendar.timegm(time.strptime(str(until), "%Y-%m-%dT%H:%M:%SZ"))
            if t <= time.time():
                return set()
        except ValueError:
            pass
    keys = exp.get("changed")
    return set(keys.keys()) if isinstance(keys, dict) else set()


def load_env(path):
    """读 env 文件成 dict。**不打印值** —— 调用方只应报告长度/键名。"""
    out = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def http_json(url, method="GET", body=None, token=None, timeout=90):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def tg(msg):
    """推 Telegram。缺 token/chat_id 就静默跳过 —— 推送失败不能影响优化主流程。"""
    tok = os.environ.get("_TG_TOKEN")
    chat = os.environ.get("_TG_CHAT")
    if not tok or not chat:
        return
    try:
        req = urllib.request.Request(
            "https://api.telegram.org/bot%s/sendMessage" % tok,
            data=json.dumps({"chat_id": chat, "text": msg[:3900],
                             "disable_web_page_preview": True}).encode(),
            headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=20).read()
    except Exception as e:                      # noqa: BLE001 - 推送是尽力而为
        print("[warn] tg push failed: %s" % type(e).__name__, file=sys.stderr)


def strip_heavy(ctx):
    """剥掉 current_code（实测 84KB/103KB）—— 调 config 用不上 84KB 源码，
    留着只会稀释 LLM 注意力并把 token 成本抬 5 倍。"""
    if isinstance(ctx, dict):
        ctx.pop("current_code", None)
    return ctx


def build_prompt(ctx, cfg):
    """把实测事实写进 system prompt —— 防止 LLM 给出反算术的建议。"""
    tw = ctx.get("trades_window") or {}
    bx = ctx.get("binance") or {}
    it = bx.get("income_totals") or {}
    pt = bx.get("paired_trades") or {}

    realized = it.get("REALIZED_PNL")
    commission = it.get("COMMISSION")
    funding = it.get("FUNDING_FEE")
    net = None
    if realized is not None:
        net = realized + (commission or 0) + (funding or 0)

    facts = []
    facts.append("窗口内配对交易 n=%s, 胜率=%s%%, 多头净=%s, 空头净=%s"
                 % (pt.get("pair_count"), pt.get("win_rate_pct"),
                    pt.get("long_net_pnl"), pt.get("short_net_pnl")))
    if realized is not None:
        facts.append("已实现盈亏(不含费)=%s U, 手续费=%s U, 资金费=%s U, **净=%s U**"
                     % (realized, commission, funding, net))
        if net and net < 0 and commission:
            facts.append("手续费占净亏损的 %.0f%% —— 提高交易频率会等比例放大它"
                         % (abs(commission) / abs(net) * 100))
    facts.append("Account 未实现=%s, 持仓数=%s"
                 % (ctx.get("account", {}).get("unrealized_pnl"),
                    ctx.get("account", {}).get("open_positions")))

    return """你是量化策略参数优化器。只输出 JSON，不要任何解释文字。

## 硬边界（越界建议会被程序直接 clamp，不要浪费输出）
- leverage∈[2,20]; order_amount_pct∈[0.05,0.75]; cooldown_sec∈[180,1800]
- max_concurrent_positions ≤ 10; Σ(order_amount_pct × max_concurrent_positions) ≤ 0.75
- entry_time_windows 保持 ""; 严禁马丁/加倍摊平
- 不可改: symbols / auto_symbols / symbol_blacklist / allowed_sides / entry_time_windows

## 必须知道的实测事实（忽略它们会给出错误建议）
1. **手续费是主要对手**（结构事实，不是当期数字）：该策略的毛盈亏长期被手续费吃掉
   大半，历史上反复出现「手续费 ≈ 全部毛亏损」。**本节任何历史数字都会过时，一律不要
   引用** —— 当期真实数字只认下面「本窗口实测数据」里注入的 facts。
   判断口径：毛盈亏是否显著大于一趟来回的费用；不覆盖时提高交易频率 = 加速亏损。
2. **回测无法验证 TP/SL**：回测走 Python 的 ATR 值，实盘由 resolveTPSLFromROI 用
   take_profit_pct/stop_loss_pct ÷ leverage 无条件覆盖。两者不是同一条逻辑。
   所以不要建议"先回测验证" —— 那不是可用手段。
3. **生效范围是分组的（逐键实测，别一律当成"要重启"）**：
   多数键（leverage、order_amount_pct、max_concurrent_positions、take_profit_pct、
   stop_loss_pct、trailing_*、hunger_*、conf_sizing_*）改完**下一次开仓/平仓即生效**；
   少数键（cooldown_sec、long_conf_premium、short_conf_premium、volume_ratio_min、
   best_pick_enabled、best_pick_window_sec、min_confidence）由 Python 子进程在 spawn
   时从 argv 读走，**要 stop+start 才换**。
   只改第一组 → 你能立刻看到效果；只改第二组 → 要等重启才生效。
4. **max_concurrent_positions 通常不是瓶颈**：实测槽位占用 7-8/10。
   开仓数受槽位周转率限制（槽位数 ÷ 平均持仓时长）。
5. **止盈可能从不触发**：实测 75 笔中 TP 命中 0 次，全部由追踪止损/硬止损/超时强平退出。
   若 take_profit_pct 远离实际波幅，调它没有意义。

## 当前配置（节选）
%s

## 本窗口实测数据
%s

## 输出格式（严格 JSON，字段不全视为无效）
{
  "diagnosis": "≤150字，基于上面的数字说明当前最主要的问题",
  "changes": [
    {"key": "参数名", "from": 现值, "to": 建议值, "reason": "≤60字，必须引用上面的数字"}
  ],
  "no_change_reason": "若 changes 为空，说明为什么不该动",
  "confidence": "low|medium|high"
}
changes 最多 2 项。改动幅度不超过现值 2 倍。没有足够证据就返回空 changes —— 不动也是正确的决定。
""" % (json.dumps(cfg, ensure_ascii=False, indent=1),
       "\n".join("- " + f for f in facts))


def parse_llm(raw):
    """LLM 输出容错解析：剥 markdown 围栏，取第一个平衡的 JSON 对象。"""
    s = raw.strip()
    if s.startswith("```"):
        s = s.split("\n", 1)[1] if "\n" in s else s
        if s.rstrip().endswith("```"):
            s = s.rstrip()[:-3]
    i, j = s.find("{"), s.rfind("}")
    if i < 0 or j <= i:
        raise ValueError("no JSON object in LLM output")
    return json.loads(s[i:j + 1])


def validate(change, cfg):
    """白名单 + clamp + 漂移。返回 (ok, value, note)。"""
    key = change.get("key")
    if not isinstance(key, str) or not key:
        return False, None, "缺少 key"
    if key in FORBIDDEN_EXACT or key.startswith(FORBIDDEN_PREFIX):
        return False, None, "禁止修改的键（身份/币池/实验记录/自身配置）"
    if key not in BOUNDS:
        return False, None, "不在白名单内"
    if key not in cfg:
        return False, None, "配置中不存在该键（拼写错误？）"

    old = cfg[key]
    new = change.get("to")
    if isinstance(old, bool) or key in ("best_pick_enabled", "trailing_enabled",
                                        "use_exchange_tpsl", "hunger_mode_enabled",
                                        "conf_sizing_enabled"):
        if not isinstance(new, bool):
            return False, None, "该键是布尔值"
        return True, new, ""
    if not isinstance(new, (int, float)) or isinstance(new, bool):
        return False, None, "非数值"
    try:
        oldf, newf = float(old), float(new)
    except (TypeError, ValueError):
        return False, None, "现值非数值"

    lo, hi = BOUNDS[key]
    note = ""
    if newf < lo or newf > hi:
        note = "越界 [%s,%s]，已 clamp" % (lo, hi)
        newf = min(max(newf, lo), hi)
    # 漂移检查只在两端都非 0 时有意义 —— 0 到非 0（或反向）算不出比率，
    # 交给 BOUNDS 的区间去兜。symbol_reentry_cooldown_minutes 的 0 是合法值。
    if oldf != 0 and newf != 0:
        ratio = newf / oldf
        if ratio < 1 / MAX_DRIFT or ratio > MAX_DRIFT:
            return False, None, "单次漂移超过 %.1fx" % MAX_DRIFT
    if abs(newf - oldf) < 1e-12:
        return False, None, "与现值相同"
    return True, newf, note


def main():
    benv = load_env(BACKEND_ENV)
    aienv = load_env(AI_ENV)
    key = aienv.get("DEEPSEEK_API_KEY", "")
    if not key:
        print("[fatal] no DEEPSEEK_API_KEY in %s" % AI_ENV, file=sys.stderr)
        return 2
    # TG 凭据经环境变量传给 tg()，避免全局变量在整个进程里可读
    os.environ["_TG_TOKEN"] = benv.get("TELEGRAM_BOT_TOKEN", "")
    os.environ["_TG_CHAT"] = benv.get("TELEGRAM_CHAT_ID", "")

    try:
        tok = http_json(BACKEND + "/api/login", "POST",
                        {"username": "admin", "password": benv.get("ADMIN_PASSWORD", "")}).get("token")
    except Exception as e:                      # noqa: BLE001
        print("[fatal] backend login failed: %s" % e, file=sys.stderr)
        return 2
    if not tok:
        print("[fatal] no token returned by /api/login", file=sys.stderr)
        return 2

    ctx = http_json("%s/api/admin/optimize/context?strategy_id=%s&hours=%d"
                    % (BACKEND, STRATEGY_ID, WINDOW_HOURS), token=tok)
    cfg = ctx.get("config") or {}
    exp = cfg.get("_exp")
    ctx = strip_heavy(ctx)

    tw = ctx.get("trades_window") or {}
    n = tw.get("count") or 0
    print("[info] window=%dh trades=%s win_rate=%s%% pnl=%s"
          % (WINDOW_HOURS, n, tw.get("win_rate_pct"), tw.get("realized_pnl")))

    if n < MIN_TRADES:
        msg = ("样本不足：窗口 %dh 内仅 %d 笔（阈值 %d），本轮不优化。"
               % (WINDOW_HOURS, n, MIN_TRADES))
        print("[skip] " + msg)
        tg("🤖 自动优化 | 跳过\n" + msg)
        return 0

    prompt = build_prompt(ctx, cfg)
    if exp:
        prompt += "\n## 进行中的实验记录 _exp（不得覆盖，不得据此改同段参数）\n%s\n" % json.dumps(exp, ensure_ascii=False)[:1200]

    try:
        resp = http_json("https://api.deepseek.com/v1/chat/completions", "POST", {
            "model": MODEL,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.2,
        }, token=key, timeout=180)
        raw = resp["choices"][0]["message"]["content"]
    except Exception as e:                      # noqa: BLE001
        print("[fatal] deepseek call failed: %s" % e, file=sys.stderr)
        return 2

    try:
        verdict = parse_llm(raw)
    except Exception as e:                      # noqa: BLE001
        print("[fatal] unparseable LLM output: %s\n--- raw ---\n%s" % (e, raw[:800]), file=sys.stderr)
        return 2

    accepted, rejected = [], []
    for ch in (verdict.get("changes") or [])[:2]:
        ok, val, note = validate(ch, cfg)
        if ok:
            accepted.append({"key": ch["key"], "from": cfg[ch["key"]], "to": val,
                             "reason": ch.get("reason", ""), "note": note})
        else:
            rejected.append({"key": ch.get("key"), "why": note})

    # 实验期冻结：_exp.changed 列出的键在实验结束前不许再动。
    # 放在 §8 之前 —— 被冻结的键不算"接受"，不该参与组保证金投影。
    hold = experiment_hold(cfg)
    if hold:
        _keep = []
        for a in accepted:
            if a["key"] in hold:
                rejected.append({"key": a["key"], "why": "实验 _exp 进行中，该键已冻结"
                                                        "（eval_after=%s）"
                                 % (cfg.get("_exp") or {}).get("eval_after")})
            else:
                _keep.append(a)
        accepted = _keep

    # 组保证金不变式 §8 复核：接受的改动若破坏 Σ(pct×mcp)≤0.75，整批拒绝
    proj = dict(cfg)
    for a in accepted:
        proj[a["key"]] = a["to"]
    try:
        exposure = float(proj.get("order_amount_pct", 0)) * float(proj.get("max_concurrent_positions", 0))
    except (TypeError, ValueError):
        exposure = 0.0
    if exposure > 0.75:
        rejected.append({"key": "(整批)", "why": "Σ(pct×mcp)=%.3f > 0.75，违反边界 §8" % exposure})
        accepted = []

    lines = ["🤖 DeepSeek 自动优化 | %s" % time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime()),
             "窗口 %dh | %d 笔 | 胜率 %s%% | PnL %s"
             % (WINDOW_HOURS, n, tw.get("win_rate_pct"), tw.get("realized_pnl")),
             "", "诊断: " + str(verdict.get("diagnosis", ""))[:300], ""]

    if accepted:
        lines.append("建议改动:")
        for a in accepted:
            lines.append("  • %s: %s → %s  (%s)%s"
                         % (a["key"], a["from"], a["to"], a["reason"],
                            "  ⚠️" + a["note"] if a["note"] else ""))
    else:
        lines.append("建议改动: 无 —— " + str(verdict.get("no_change_reason", ""))[:200])
    if rejected:
        lines.append("")
        lines.append("被拒:")
        for r in rejected:
            lines.append("  ✗ %s: %s" % (r["key"], r["why"]))
    lines.append("")
    lines.append("置信度: %s | 模式: %s" % (verdict.get("confidence"), "dry-run(未落配置)" if DRY_RUN else "APPLY"))

    # ---- 落配置。默认不走这里。 ----
    if accepted and not DRY_RUN:
        patch = {a["key"]: a["to"] for a in accepted}
        try:
            r = http_json("%s/api/strategies/%s/config" % (BACKEND, STRATEGY_ID),
                          "PATCH", patch, token=tok)
            lines.append("已落配置: %s" % json.dumps(r, ensure_ascii=False))
            # 分组报生效状态：一律说"要重启"是错的，多数键下次开/平仓即生效。
            imm = sorted(k for k in patch if k not in RESTART_REQUIRED)
            rst = sorted(k for k in patch if k in RESTART_REQUIRED)
            if imm:
                lines.append("✅ 已即时生效（下次开仓/平仓）：%s" % ", ".join(imm))
            if rst:
                lines.append("⚠️ 需 stop+start 才生效（当前进程仍跑旧值）：%s" % ", ".join(rst))
        except Exception as e:                  # noqa: BLE001
            lines.append("落配置失败: %s" % e)

    out = "\n".join(lines)
    print(out)
    tg(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
